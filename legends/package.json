{
  "name": "github-legends",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Legends: deterministic game engine and data collection for a GitHub profile README.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:readme",
    "preview:map": "node scripts/preview-map.ts",
    "preview:readme": "node scripts/preview-readme.ts",
    "check:readme": "node scripts/check-readme.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.19.1",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
